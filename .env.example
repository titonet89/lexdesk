# Copiar como .env.local y completar.

# URL definitiva del sitio (habilita la indexación en buscadores en producción).
# NEXT_PUBLIC_SITE_URL=https://www.ejemplo.com.ar

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SOLO SERVIDOR. Nunca exponer en el navegador ni subir al repositorio.
SUPABASE_SECRET_KEY=

# Perfil público del estudio en JSON (ver site-profile.example.json). Si falta, se usa el perfil demo.
# En Vercel: npx vercel env add NEXT_PUBLIC_SITE_PROFILE production < site-profile.local.json
# NEXT_PUBLIC_SITE_PROFILE=
